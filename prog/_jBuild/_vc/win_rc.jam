actions together quietly compile_rc
{
#async
  echo compiling RC: $(2:D=)
  set_filter nul /(Resource Compiler Version)|(All rights reserved)|(^$)/
  call_filtered $(_RC_COMPILER) $(rc_opt) /fo #\( "$(rc_output:S=)" "$(2)" )\#
  clr_filters
  if errorlevel 1 goto failed
  call $(_CVTRES_EXE) #\( -out:"$(rc_output)" "$(rc_output:S=)" )\#
  if errorlevel 1 goto failed
  call $(ComSpec) /C #\( if not exist "$(rc_output)" exit /b 13 )\#
  if errorlevel 1 goto failed
  call $(_DEP_COMPILER) $(pre_opt) $(_C_BASE_INCLUDES) $(rc_opt) #\( --o"$(rc_output:S=.d)" "$(2:G=)" )\#
  call $(ComSpec) /C #\( if not exist "$(rc_output:S=.d)" exit /b 13 )\#
  if errorlevel 1 goto failed
  goto end
  :failed
  set ERRORLEVEL=13
  :end
}
