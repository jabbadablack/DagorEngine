Root    ?= ../../../../.. ;
StrictCompile = yes ;
PlatformSpec_windows_x86_64 = clang ;
CheckedContainers ?= yes ;

Location = prog/gameLibs/render/daFrameGraph/tests ;
DAFG_ENABLE_UNIT_TESTS = yes ; # link the library variant with its embedded unit tests
Target   = daFrameGraph-tests ;

include $(Root)/prog/_jBuild/unitTest.jam ;

UseD3DMulti = yes ;
UseD3DMultiList = DX12 vulkan stub ;
UseD3DMultiForced = windows macOS ; # the multi-driver interface (d3di) even with the stub alone: drv3d_Metal has no multi-driver build
LinuxUseGUI = yes ;
include $(Root)/prog/engine/drv/drv3d_DX12/copy_bundles.jam ;
include $(Root)/prog/engine/drv/drv3d_commonCode/copy_bundles.jam ;

if $(PlatformSpec) = clang
{
  # These warnings are enabled by default on some systems and are
  # caught by BS but not while developing. Manually enabling them saves
  # BS' and my time.
  CPPopt +=
    -Wc++11-narrowing
    -Wswitch
    -Wbitfield-constant-conversion
    -Wmissing-field-initializers
  ;
}

UseProgLibs +=
  engine/memory
  engine/kernel
  engine/osApiWrappers
  engine/coreUtil
  engine/baseUtil
  engine/ioSys
  engine/math
  engine/shaders
  engine/lib3d
  engine/image
  engine/startup
  engine/workCycle
  engine/perfMon/stub

  engine/drv/drv3d_pc_multi

  3rdPartyLibs/eastl

  gameLibs/render/daFrameGraph
;

if $(Platform) = linux {
  UseProgLibs +=
    engine/osApiWrappers/messageBox
  ;
}

ShaderVarsStub ?= mock ;

AddIncludes +=
  $(Root)/$(Location)/..
  $(Root)/prog/gameLibs/publicInclude
;

Sources =
  main.cpp
  benchmark.cpp
  packer.cpp
  performance.cpp
  runtime.cpp
  multiplexing.cpp
  idContainers.cpp
  barrierScheduler.cpp
  cycAlloc.cpp
  bitSearch.cpp
  irGraphBuilder.cpp
  nodeStateDeltas.cpp
  nodeRemap.cpp
  resourceScheduler.cpp
  virtualPassRequest.cpp
  refinedBlock.cpp
;

include $(Root)/prog/_jBuild/build.jam ;
