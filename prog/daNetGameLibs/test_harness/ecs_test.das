options gen2
options indenting = 2
options no_aot
options strict_smart_pointers

module ecs_test shared public

//! In-game tests. A function annotated with ``[ecs_test]`` runs inside the real game when it's started in test mode
//! (``-das_test:<path>``, see prog/daNetGame/main/testMode.h), with every game module, ECS system and template available:
//!
//!   require danetlibs/test_harness/ecs_test
//!
//!   [ecs_test]
//!   def spawned_entity_moves(t : T?) {
//!     let eid = createEntitySync("my_mover")
//!     advance_frames(30)                      // runs 30 real game frames of test_mode_fixed_dt() each
//!     t |> success(get_float(eid, "pos_x") ?? 0. > 0.)
//!   }
//!
//! The body uses dastest's T API (equal, success, run, skip, ...). Errors logged while a test runs fail it unless
//! expected with expect_logerr.

require daslib/ast
require daslib/ast_boost
require daslib/templates_boost
require daslib/rtti
require strings
require DngTestMode public
require dastest/testing_boost public

[function_macro(name="ecs_test")]
class EcsTestAnnotation : AstFunctionAnnotation {
  //! Generates, next to the test, an exported wrapper the test mode calls and an [init] function registering it.
  def override patch(var func : FunctionPtr; var group : ModuleGroup; args, progArgs : AnnotationArgumentList; var errors : das_string;
                     var astChanged : bool&) : bool {
    for (ann in func.annotations) {
      if (ann.annotation.name == "ecs_test" && !(find_arg(ann.arguments, "patched") is nothing)) {
        return true
      }
    }
    let arg_ok = (length(func.arguments) == 1 && func.arguments[0]._type.isPointer && func.arguments[0]._type.firstType != null
                  && func.arguments[0]._type.firstType.isStructure && func.arguments[0]._type.firstType.structType.name == "T")
    if (!arg_ok) {
      errors := "[ecs_test] expects def {func.name}(t : T?)"
      return false
    }
    for (ann in func.annotations) {
      if (ann.annotation.name == "ecs_test") {
        astChanged = true
        ann.arguments |> add_annotation_argument("patched", true)
      }
    }

    let testName = "{func.name}"
    let wrapperName = "__ecs_test`{func.name}"
    let file = func.at.fileInfo != null ? "{func.at.fileInfo.name}" : ""
    let line = int(func.at.line)

    var wrapper <- qmacro_function(wrapperName) $() {
      run_ecs_test($v(testName), @@$c(testName))
    }
    wrapper.flags |= FunctionFlags.generated | FunctionFlags.exports
    compiling_module() |> add_function(wrapper)

    var registration <- qmacro_function("__ecs_test_register`{func.name}") $() {
      test_mode_register($v(testName), $v(wrapperName), $v(file), $v(line))
    }
    registration.flags |= FunctionFlags.generated | FunctionFlags.init | FunctionFlags.privateFunction
    compiling_module() |> add_function(registration)
    return true
  }
}

def private file_name(at : LineInfo) : string {
  return at.fileInfo != null ? "{at.fileInfo.name}" : ""
}

def private run_case(name : string; f : RunT; is_sub_test : bool) {
  if (is_sub_test) {
    test_mode_begin_case(name)
  }
  var testing = new T(name, ref_time_ticks(), false)
  var deliberateRecover = false
  unsafe {
    testing.onFail <- @ capture(& deliberateRecover)(now : bool) {
      test_mode_fail(now)
      if (now) {
        deliberateRecover = true
      }
    }
    testing.onSkipNow <- @ capture(& deliberateRecover)() {
      test_mode_skip()
      deliberateRecover = true
    }
  }
  testing.onLog <- @(msg : string; at : LineInfo) {
    test_mode_log(msg, file_name(at), int(at.line))
  }
  testing.onRun <- @(sub_name : string; sub : RunT) {
    run_case("{name}/{sub_name}", sub, true)
  }
  try {
    if (f is func1) {
      invoke(f as func1, testing)
    } else {
      invoke(f as lmd1, testing)
    }
  } recover {
    if (!deliberateRecover) {
      let ctx & = this_context()
      test_mode_fail(false)
      test_mode_log("panic: {ctx.last_exception |> rtrim}", file_name(ctx.exceptionAt), int(ctx.exceptionAt.line))
    }
  }
  unsafe {
    delete testing
  }
  if (is_sub_test) {
    test_mode_end_case()
  }
}

def run_ecs_test(name : string; fn : function<(t : T?) : void>) {
  //! Runs a test function with dastest's T, reporting to the test mode. Called by the wrapper generated by [ecs_test].
  run_case(name, RunT(func1 = fn), false)
}

def expect_logerr(t : T?; substr : string; count : int; blk : block<() : void>) {
  //! Expects ``count`` errors containing ``substr`` to be logged by ``blk``: they don't fail the test, any other count does.
  let handle = test_mode_push_logerr_expectation(substr)
  invoke(blk)
  let logged = test_mode_pop_logerr_expectation(handle)
  t |> equal(logged, count, "errors containing \"{substr}\"")
}

def advance_until(t : T?; max_frames : int; cond : block<() : bool>) : bool {
  //! Runs game frames until ``cond`` holds; fails the test when it doesn't within ``max_frames``.
  for (_ in range(max_frames)) {
    if (invoke(cond)) {
      return true
    }
    advance_frames(1)
  }
  if (invoke(cond)) {
    return true
  }
  t |> failure("condition not met within {max_frames} frames")
  return false
}
