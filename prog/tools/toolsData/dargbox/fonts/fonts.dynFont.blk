  baseFont:t="jetbrains-mono-nl-regular.ttf"
  optional:b=yes
}

baseFontData{
  baseFont:t="fontawesome-webfont.ttf"
  forceAutoHint:b=no
  optional:b=yes
}

font{
  name:t="lato-regular"
  baseFontData:i=0
}

font{
  name:t="firasans-medium"
  baseFontData:i=1
}

font{
  name:t="mono"
  baseFontData:i=2
}

font{
  name:t="fontawesome"
  baseFontData:i=3
}

