node{
  id:i=16
  x:r=560
  y:r=1660
  descName:t="extract_color"
  plugin:t="shader_editor"

  pin{
    name:t="out"
    role:t="out"
    types:t="texture2D"
  }

  pin{
    name:t="texture"
    role:t="in"
    types:t="texture2D"
  }

  pin{
    name:t="color"
    role:t="in"
    types:t="float4"

    data{
      blk_code:t="%color.x%, %color.y%, %color.z%, %color.w%"
      code:t="float4(%color.x%, %color.y%, %color.z%, %color.w%)"
    }
  }

  pin{
    name:t="channels mask"
    role:t="in"
    types:t="float4"

    data{
      blk_code:t="%channels mask.x%, %channels mask.y%, %channels mask.z%, %channels mask.w%"
      code:t="float4(%channels mask.x%, %channels mask.y%, %channels mask.z%, %channels mask.w%)"
    }
  }

  pin{
    name:t="sensitivity"
    role:t="in"
    types:t="float"

    data{
      blk_code:t="%sensitivity%"
      code:t="%sensitivity%"
    }
  }

  pin{
    name:t="threshold"
    role:t="in"
    types:t="float"

    data{
      blk_code:t="%threshold%"
      code:t="%threshold%"
    }
  }

  property{
    name:t="color.x"
    val:t="1.0"
  }

  property{
    name:t="color.y"
    val:t="0.0"
  }

  property{
    name:t="color.z"
    val:t="0.0"
  }

  property{
    name:t="color.w"
    val:t="0.0"
  }

  property{
    name:t="channels mask.x"
    val:t="1.0"
  }

  property{
    name:t="channels mask.y"
    val:t="1.0"
  }

  property{
    name:t="channels mask.z"
    val:t="1.0"
  }

  property{
    name:t="channels mask.w"
    val:t="0.0"
  }

  property{
    name:t="sensitivity"
    val:t="1.0"
  }

  property{
    name:t="threshold"
    val:t="0.0"
  }

  property{
    name:t="texture width"
    val:t="parent size"
  }

  property{
    name:t="texture height"
    val:t="width"
  }

  property{
    name:t="texture type"
    val:t="parent type"
  }

  property{
    name:t="texture wrap"
