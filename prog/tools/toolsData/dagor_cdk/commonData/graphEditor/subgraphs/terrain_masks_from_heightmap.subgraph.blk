    data{
      blk_code:t="%color.x%, %color.y%, %color.z%, %color.w%"
      code:t="float4(%color.x%, %color.y%, %color.z%, %color.w%)"
    }
  }

  pin{
    name:t="channels mask"
    role:t="in"
    types:t="float4"

    data{
      blk_code:t="%channels mask.x%, %channels mask.y%, %channels mask.z%, %channels mask.w%"
      code:t="float4(%channels mask.x%, %channels mask.y%, %channels mask.z%, %channels mask.w%)"
    }
