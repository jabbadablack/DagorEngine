    name:t="out"
    role:t="out"
    types:t="texture2D"
  }

  pin{
    name:t="random_seed"
    role:t="in"
    types:t="float"

    data{
      blk_code:t="%random_seed%"
      code:t="%random_seed%"
    }
  }

  pin{
    name:t="threshold"
    role:t="in"
    types:t="float"

    data{
      blk_code:t="%threshold%"
      code:t="%threshold%"
    }
  }

  property{
    name:t="random_seed"
    val:t="1.0"
  }

  property{
    name:t="threshold"
    val:t="0.0"
  }

  property{
    name:t="texture width"
    val:t="parent size"
  }

  property{
    name:t="texture height"
    val:t="width"
  }

  property{
    name:t="texture type"
    val:t="ARGB8"
  }

  property{
    name:t="texture wrap"
    val:t="parent wrap"
  }
}

