  float2 _v_16_0 = _in.tc;
  float4 _v_15_2 = linear_sample(_in.sampler1_t, _v_16_0, _in.sampler1_wrap);
  float4 _v_4_2 = (float4(_in._power_60890, _in._power_60890, _in._power_60890, _in._power_60890) * _v_15_2);
  float4 _v_11_2 = (float4(_v_9_2, 0.0, 0.0) * _v_4_2);
  float4 _v_10_2 = (_v_11_2 + float4(_v_2_0, 0.0, 0.0));
  float4 _v_12_2 = linear_sample(_in.sampler0_t, _v_10_2.xy, _in.sampler0_wrap);
