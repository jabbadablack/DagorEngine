 float4 col0:SV_Target0;  """
    shader_function:t="""

  void _function_soft_threshold(InputStruct_soft_threshold _in, out OutputStruct_soft_threshold _out) {

  float4 _v_0_1 = linear_sample(_in.sampler0_t, _in.tc, _in.sampler0_wrap);
  float _v_1_1 = _v_0_1.x;
  _out._y_46556 = _v_0_1.y;
  _out._z_46559 = _v_0_1.z;
  _out._w_46546 = _v_0_1.w;
  float _v_5_1 = 1.0 - _in._contrast_35335;
  float _v_10_0 = 0.5;
  float _v_9_2 = (_v_5_1 * _v_10_0);
  float _v_6_2 = (_in._threshold_12274 + _v_9_2);
  float _v_7_2 = (_in._threshold_12274 - _v_9_2);
  float _v_2_3 = saturate((_v_1_1 - _v_7_2) / (_v_6_2 - _v_7_2));
  _out.col0 = float4(_v_2_3, _v_2_3, _v_2_3, _v_2_3);

  }"""
