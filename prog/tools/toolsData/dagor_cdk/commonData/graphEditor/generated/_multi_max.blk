  float4 _v_8_1 = linear_sample(_in.sampler7_t, _in.tc, _in.sampler7_wrap);
  float4 _v_0_2 = max(_v_1_1, _v_2_1);
  float4 _v_9_2 = max(_v_0_2, _v_3_1);
