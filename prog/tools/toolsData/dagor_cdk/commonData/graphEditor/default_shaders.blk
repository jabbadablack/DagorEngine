perlin
{
 outputs:i=1
 params
 {
   octaves:i=5
   persistence:r=0.5
   frequency:r=1
   scale:r=1
   ofs:p2=0,0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     int octaves;
     float persistence;
     float frequency;
     float scale;
     float2 ofs;
   };

 """
 shaderCode:t="""
 float2 pt = input.tc*frequency+ofs;
 int totalOctaves = min(octaves, 16);
 float ret = 0;
 float cscale = 1, totalScale = 0;
 float cosFib, sinFib;
 sincos((sqrt(5)*1 + 1)*2*PI, sinFib, cosFib);
 [loop]
 for (int i = 0; i < totalOctaves; ++i)
 {
   ret += noise_Perlin2D(pt)*cscale;
   //ret += (noise_Value2D(pt)*2-1)*cscale;
   totalScale += cscale;
   pt += pt;
   pt = float2(pt.x*cosFib + pt.y*sinFib, -sinFib*pt.x + pt.y*cosFib);
   cscale *= persistence;
 }
 result.col0 = input.tc.z*scale*(ret/max(0.0001,totalScale)*0.5+0.5);
// result.col0 = length(input.tc.xy-float2(0.75,0.5))<0.21;
"""
}

perlin_terrain
{
 outputs:i=1
 params
 {
    height_scale:r=1
    tiling:r=1
    offset:p2=0,0

    octaves:i=5
    roughness:r=0.5
    frequency:r=2
    gradient:r=0

    use_3d_noise:b=no
    type:i=0
 }
 shaderPreMain:t="""
  cbuffer global
  {
    float height_scale;
    float tiling;
    float2 offset;

    int octaves;
    float roughness;
    float frequency;
    float gradient;

    bool use_3d_noise;
    int type;
  };
 """
 shaderCode:t="""
  static float cosFib, sinFib;
  sincos(0.6472222*2*PI, sinFib, cosFib); // Some bs rotation coeffs
  const float2x2 m = {cosFib, sinFib, -sinFib, cosFib};

  float2 P = input.tc.xy*tiling + offset;

  //// fBm(P)
  // https://iquilezles.org/articles/morenoise/

  int idx0 = type > 3;
  int idx1 = idx0 ? 3 : clamp(type, 0, 3);

  int totalOctaves = min(octaves, 16);
  float height = 0, mult = 1;
  float3 derivatives = 0;
  float4 noise = 0;
  float curScale = 1, totalScale = 0;
  float2x2 curM = {1,0,0,1};
  float3 curDerivatives;

  [loop]
  for (int i = 0; i < totalOctaves; ++i)
  {
    // Switch noise type, og article uses 3d noise, but it doesnt morph into existing 2d noise
    if(use_3d_noise) {
      noise = noise_Perlin3D_Deriv(float3(P, 0.5));
    } else {
      noise = float4(noise_Perlin2D_Deriv(P), 0);
    }
    curDerivatives = float3(mul(noise.yz, invMat(curM)), noise.w);

    // Og article have no derivative scaling, but resulting derivatives will be incorrect this way
    if(idx0 == 1) {
      derivatives += curDerivatives*curScale; // Accumulate derivatives
    } else {
      derivatives += curDerivatives; // Accumulate derivatives
    }

    mult = 1.0 / (1.0 + gradient*dot(derivatives,derivatives) );
    height += noise.x*curScale*mult; // Accumulate height

    // Og article have no derivative correction, but after applying height with derivative coeff, it should be recalculated (idx1=3)
    // All these methods produce drastically different results, so let users worry about them :o)
    if(idx1 == 1) {
      derivatives += curDerivatives*curScale*(-1 + mult);
    } else if(idx1 == 2) {
      derivatives += curDerivatives*(-1 + mult);
    } else if(idx1 == 3) {        
      derivatives += curDerivatives*(-1 + mult*curScale);
    }      

    totalScale += curScale; // Accumulate height scale

    curScale *= roughness; // Next current scale
    curM = mul(m, curM); // Next rot matrix
    P = mul(P*frequency, curM); // Rotate P by some bs coeffs    
  } // end fBm

  result.col0 = float4(input.tc.z*height_scale * (height /max(0.0001,totalScale) *0.5 + 0.5), derivatives);
"""
}

voronoi
{
 outputs:i=1
 params
 {
   randomness:r=1
   scale:r=1
   offset:p2=0,0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     float randomness;
     float scale;
     float2 offset;
   };

 """
 shaderCode:t="""
 float2 P = ( input.tc.xy + offset ) * scale;
 result.col0 = voronoi( P, randomness);
"""
}

cellular
{
 outputs:i=1
 params
 {
    height_scale:r=1
    tiling:r=1
    offset:p2=0,0
    randomness:r=1.0
    metric:i=0
    output_only_F1:b="no"

    octaves:i=5
    roughness:r=0.5
    frequency:r=2
    rotation:r=0  
 }
 shaderPreMain:t="""
  cbuffer global
  {
    float height_scale;
    float tiling;
    float2 offset;
    float randomness;
    int metric;
    bool output_only_F1;

    int octaves;
    float roughness;
    float frequency;
    float rotation;  
  };
 """
 shaderCode:t="""
  static float cosFib, sinFib;
  sincos(rotation/180*PI, sinFib, cosFib);
  const float2x2 m = {cosFib, sinFib, -sinFib, cosFib};

  float2 invDims = input.tc.xy / input.pos.xy;
  float2 P = input.tc.xy * tiling + offset;
  
  //// fBm(P)
  int totalOctaves = min(octaves, 16);
  float height = 0;
  
  float4 noise = 0;
  float curScale = 1, totalScale = 0;

  [loop]
  for (int i = 0; i < totalOctaves; ++i)
  {
    noise = voronoi_metric( P, randomness, output_only_F1, metric);
    height += noise.x*curScale; // Accumulate height
    totalScale += curScale; // Accumulate height scale

    curScale *= roughness; // Next current scale
    P = mul(P*frequency, m);  
  } // end fBm

  result.col0 = input.tc.z*height_scale * height /max(0.0001,totalScale);
"""
}

perlin_tile
{
 outputs:i=1
 params
 {
   octaves:i=5
   persistence:r=0.5
   frequency:i=1
   scale:r=1
   ofs:p2=0,0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     int octaves;
     float persistence;
     int frequency;
     float scale;
     float2 ofs;
   };

 """
 shaderCode:t="""
 float2 pt = input.tc * float(frequency);
 int totalOctaves = min(octaves, 16);
 float ret = 0;
 float cscale = 1, totalScale = 0;
 float tile = float(frequency);
 [loop]
 for (int i = 0; i < totalOctaves; ++i)
 {
   ret += noise_Perlin2D_tile(pt, ofs, tile) * cscale;
   totalScale += cscale;
   pt += pt;
   cscale *= persistence;
   tile += tile;
 }
 result.col0 = input.tc.z*scale*(ret/max(0.0001,totalScale)*0.5+0.5);
// result.col0 = length(input.tc.xy-float2(0.75,0.5))<0.21;
"""
}

perlin_tile_octaves
{
 outputs:i=1
 params
 {
   amp1:r=1.0
   amp2:r=0.5
   amp3:r=0.25
   amp4:r=0.125
   amp5:r=0.0625
   amp6:r=0.03125
   amp7:r=0.015625
   amp8:r=0.0078125
   amp9:r=0.00390625
   amp10:r=0.001953125
   frequency:i=1
   scale:r=1
   ofs:p2=0,0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     float amp1;
     float amp2;
     float amp3;
     float amp4;
     float amp5;
     float amp6;
     float amp7;
     float amp8;
     float amp9;
     float amp10;
     int frequency;
     float scale;
     float2 ofs;
   };

 """
 shaderCode:t="""
 float2 pt = input.tc * float(frequency);
 float ret = 0;
 float totalScale = 0;
 float tile = float(frequency);

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp1;
 totalScale += amp1; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp2;
 totalScale += amp2; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp3;
 totalScale += amp3; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp4;
 totalScale += amp4; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp5;
 totalScale += amp5; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp6;
 totalScale += amp6; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp7;
 totalScale += amp7; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp8;
 totalScale += amp8; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp9;
 totalScale += amp9; pt += pt; tile += tile;

 ret += noise_Perlin2D_tile(pt, ofs, tile) * amp10;
 totalScale += amp10; pt += pt; tile += tile;

 result.col0 = input.tc.z*scale*(ret/max(0.0001,totalScale)*0.5+0.5);
"""
}

particles
{
 outputs:i=1
 params
 {
   octaves:i=5
   persistence:r=0.5
   frequency:r=1
   scale:r=1
   threshold:r=0.75
   size:r=0.01
 }
 shaderPreMain:t="""
   cbuffer global
   {
     int octaves;
     float persistence;
     float frequency;
     float scale;
     float threshold;
     float size;
   };
  #define ParticlesOutput_DEFINE u7
  #define ParticlesOutputCounter_DEFINE u6
  #define VOID_OUTPUT
  #define WRAP 1

 """
 shaderCode:t="""
 uint2 screenPos = (uint2)pos.xy;
 uint2 screenRand = scramble_TEA(screenPos);
 uint g_rng_state = screenRand.x^screenRand.y;
 rand_lcg(g_rng_state);
 float randProb = rand_lcg_float(g_rng_state);
 float2 randPos2 = float2(rand_lcg_float(g_rng_state), rand_lcg_float(g_rng_state));
 //float2 pt = (input.tc+(randPos2-0.5)/128)*frequency;
 float2 pt = (input.tc)*frequency;
 int totalOctaves = min(octaves, 16);
 float ret = 0;
 float cscale = 1, totalScale = 0;
 [loop]
 for (int i = 0; i < totalOctaves; ++i)
 {
   ret += (noise_Value2D(pt)*2-1)*cscale;
   totalScale += cscale;
   pt += pt;
   cscale *= persistence;
 }
 ret/=max(0.0001,totalScale);
 float probability = scale*(ret*0.5+0.5);
 
 ParticleInstance particle;
 particle.pos = input.tc + size*(randPos2-0.5)/sqrt(2);
 particle.scale = size*(-0.5*ret + 0.5);
 particle.angle = ret;
 particle.brightness = 1;
 particle.depth = frac(input.tc.x/4096.0 + input.tc.y);
 //ENTITY_PROPERTIES
 particle.entityWorldPos = float3(0, 0, 0);
 particle.entityForward = float3(0, 0, 0);
 particle.entityUp = float3(0, 0, 0);
 particle.entityNameIndex = 0;
 particle.entityPlaceType = 0;
 particle.entitySeed = 0;
 particle.entityScale = float3(0, 0, 0);
 particle.reserved0 = 0;
 particle.reserved1 = 0;


 [branch]
 if (probability>threshold*randProb)
 {
   uint instIdx;
   InterlockedAdd(instancesCounter[1], 1, instIdx);
   instances[instIdx] = particle;
   wrap_particle(particle);
 }
"""
}

min_value_x8_step
{
  inputs:i = 1

  params
  {
    resultWidth:i = 1
    resultHeight:i = 1
  }
  shaderPreMain:t="""
    cbuffer global
    {
      int resultWidth;
      int resultHeight;
    };

    Texture2D tex0:register(t0);
    SamplerState sampler0:register(s0);
  """

  shaderCode:t="""
    int w, h;
    tex0.GetDimensions(w, h);
    int startX = int(input.tc.x * resultWidth) * 8;
    int startY = int(input.tc.y * resultHeight) * 8;

    float4 res = tex0[int2(startX, startY)];

    for (int x = startX; x < min(startX + 8, w); x++)
      for (int y = startY; y < min(startY + 8, h); y++)
        res = min(res, tex0[int2(x, y)]);

    result.col0 = input.tc.z * res;
  """
}

max_value_x8_step
{
  inputs:i = 1

  params
  {
    resultWidth:i = 1
    resultHeight:i = 1
  }
  shaderPreMain:t="""
    cbuffer global
    {
      int resultWidth;
      int resultHeight;
    };

    Texture2D tex0:register(t0);
    SamplerState sampler0:register(s0);
  """

  shaderCode:t="""
    int w, h;
    tex0.GetDimensions(w, h);
    int startX = int(input.tc.x * resultWidth) * 8;
    int startY = int(input.tc.y * resultHeight) * 8;

    float4 res = tex0[int2(startX, startY)];

    for (int x = startX; x < min(startX + 8, w); x++)
      for (int y = startY; y < min(startY + 8, h); y++)
        res = max(res, tex0[int2(x, y)]);

    result.col0 = input.tc.z * res;
  """
}

average_value_x8_step
{
  inputs:i = 1

  params
  {
    resultWidth:i = 1
    resultHeight:i = 1
  }
  shaderPreMain:t="""
    cbuffer global
    {
      int resultWidth;
      int resultHeight;
    };

    Texture2D tex0:register(t0);
    SamplerState sampler0:register(s0);
  """

  shaderCode:t="""
    int w, h;
    tex0.GetDimensions(w, h);
    int startX = int(input.tc.x * resultWidth) * 8;
    int startY = int(input.tc.y * resultHeight) * 8;

    float4 res = float4(0, 0, 0, 0);

    for (int x = startX; x < min(startX + 8, w); x++)
      for (int y = startY; y < min(startY + 8, h); y++)
        res += tex0[int2(x, y)];

    int count = max((min(startX + 8, w) - startX) * (min(startY + 8, h) - startY), 1);

    result.col0 = input.tc.z * res / float(count);
  """
}

autolevels_final_shader
{
  inputs:i = 3

  shaderPreMain:t="""
    Texture2D tex0:register(t0);
    Texture2D tex1:register(t1);
    Texture2D tex2:register(t2);
    SamplerState sampler0:register(s0);
    SamplerState sampler1:register(s1);
    SamplerState sampler2:register(s2);
  """

  shaderCode:t="""
    float4 minVal = tex1[int2(0, 0)];
    float4 maxVal = tex2[int2(0, 0)];
    result.col0 = saturate((linear_sample(tex0, input.tc, wrap_t0) - minVal) / (maxVal - minVal + 1e-6));
  """
}

add
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="result.col0 = input.tc.z * (linear_sample(tex0, input.tc, wrap_t0) + linear_sample(tex1, input.tc, wrap_t1));"
}

mul
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="result.col0 = input.tc.z * (linear_sample(tex0, input.tc, wrap_t0) * linear_sample(tex1, input.tc, wrap_t1));"
}

sub
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="result.col0 = input.tc.z * (linear_sample(tex0, input.tc, wrap_t0) - linear_sample(tex1, input.tc, wrap_t1));"
}

div
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="result.col0 = input.tc.z * (linear_sample(tex0, input.tc, wrap_t0) / linear_sample(tex1, input.tc, wrap_t1));"
}

blend
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="""
    float4 v0 = linear_sample(tex0, input.tc, wrap_t0);
    result.col0 = input.tc.z * lerp(v0, linear_sample(tex1, input.tc, wrap_t1), 1.0 - v0.a);
  """
}

max
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="result.col0 = input.tc.z * max(linear_sample(tex0, input.tc, wrap_t0), linear_sample(tex1, input.tc, wrap_t1));"
}


blend_screen
{
 inputs:i=3
 outputs:i=1
 params
 {
   apply:r=1.0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     float apply;
   };

   Texture2D tex0:register(t0);
   Texture2D tex1:register(t1);
   Texture2D tex2:register(t2);
   SamplerState sampler0:register(s0);
   SamplerState sampler1:register(s1);
   SamplerState sampler2:register(s2);
 """
 shaderCode:t="""
 float4 a = linear_sample(tex0, input.tc, wrap_t0);
 float4 b = linear_sample(tex1, input.tc, wrap_t1);
 float alhpa = apply * linear_sample(tex2, input.tc, wrap_t2);
 result.col0 = (1.0 - (1.0 - a) * (1.0 - b)) * alhpa + b * (1.0 - alhpa);
"""
}

blend_overlay
{
 inputs:i=3
 outputs:i=1
 params
 {
   apply:r=1.0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     float apply;
   };

   Texture2D tex0:register(t0);
   Texture2D tex1:register(t1);
   Texture2D tex2:register(t2);
   SamplerState sampler0:register(s0);
   SamplerState sampler1:register(s1);
   SamplerState sampler2:register(s2);
 """
 shaderCode:t="""
 float4 a = linear_sample(tex0, input.tc, wrap_t0);
 float4 b = linear_sample(tex1, input.tc, wrap_t1);
 result.col0.r = (a.r < 0.5) ? (2.0 * a.r * b.r) : (1.0 - 2.0 * (1.0 - a.r) * (1.0 - b.r));
 result.col0.g = (a.g < 0.5) ? (2.0 * a.g * b.g) : (1.0 - 2.0 * (1.0 - a.g) * (1.0 - b.g));
 result.col0.b = (a.b < 0.5) ? (2.0 * a.b * b.b) : (1.0 - 2.0 * (1.0 - a.b) * (1.0 - b.b));
 result.col0.a = (a.a < 0.5) ? (2.0 * a.a * b.a) : (1.0 - 2.0 * (1.0 - a.a) * (1.0 - b.a));

 float alhpa = apply * linear_sample(tex2, input.tc, wrap_t2);

 result.col0 = result.col0 * alhpa + b * (1.0 - alhpa);
"""
}


blend_multiply
{
 inputs:i=3
 outputs:i=1
 params
 {
   apply:r=1.0
 }
 shaderPreMain:t="""
   cbuffer global
   {
     float apply;
   };

   Texture2D tex0:register(t0);
   Texture2D tex1:register(t1);
   Texture2D tex2:register(t2);
   SamplerState sampler0:register(s0);
   SamplerState sampler1:register(s1);
   SamplerState sampler2:register(s2);
 """
 shaderCode:t="""
 float4 a = linear_sample(tex0, input.tc, wrap_t0);
 float4 b = linear_sample(tex1, input.tc, wrap_t1);
 float alhpa = apply * linear_sample(tex2, input.tc, wrap_t2);
 result.col0 = a * b * alhpa + b * (1.0 - alhpa);
"""
}




wt_rgb_masks_to_indices
{
  inputs:i=1
  shaderPreMain:t="""
  void swap(inout float a, inout float b) {float c = a; a = b; b = c;}
  Texture2D tex0:register(t0);
  SamplerState sampler0:register(s0);
  """
  shaderCode:t="""
  float4 w;
  w.rgb = linear_sample(tex0, input.tc, wrap_t0);
  w.w = saturate(1 - dot(w.rgb, 1));
  float4 ind = float4(0,1,2,3);
  for (uint i = 0; i < 4; ++i)
    for (uint j = i+1; j < 4; ++j)
      if (w[i] < w[j])
      {
        swap(w[i],w[j]);
        swap(ind[i],ind[j]);
      }

  result.col0.xy = ind.xy/255.;
  result.col0.z = 0;
  result.col0.w = w.x/(w.x+w.y+0.00001);
  """
}

masks_to_indices
{
  params
  {
    layer_delta:r = 0.01
    ht_mask_scale:r = 2
    layer_index0:i = 0
    layer_index1:i = 1
    layer_index2:i = 2
    layer_index3:i = 3
    layer_index4:i = 4
    layer_index5:i = 5
    layer_index6:i = 6
    layer_index7:i = 7
    layer_index8:i = 8
    layer_index9:i = 9
    layer_index10:i = 10
    layer_index11:i = 11
    layer_index12:i = 12
    layer_index13:i = 13
    layer_index14:i = 14
    layer_index15:i = 15
  }
  inputs:i=16
  shaderPreMain:t="""
    cbuffer global
    {
      float layer_delta;
      float ht_mask_scale;
      int index0;
      int index1;
      int index2;
      int index3;
      int index4;
      int index5;
      int index6;
      int index7;
      int index8;
      int index9;
      int index10;
      int index11;
      int index12;
      int index13;
      int index14;
      int index15;
    };

    Texture2D tex0:register(t0);
    Texture2D tex1:register(t1);
    Texture2D tex2:register(t2);
    Texture2D tex3:register(t3);
    Texture2D tex4:register(t4);
    Texture2D tex5:register(t5);
    Texture2D tex6:register(t6);
    Texture2D tex7:register(t7);
    Texture2D tex8:register(t8);
    Texture2D tex9:register(t9);
    Texture2D tex10:register(t10);
    Texture2D tex11:register(t11);
    Texture2D tex12:register(t12);
    Texture2D tex13:register(t13);
    Texture2D tex14:register(t14);
    Texture2D tex15:register(t15);
    void swap(inout float a, inout float b) {float c = a; a = b; b = c;}
    #define GET_LAYER(L) {indices[L] = index##L; layers[L] = linear_sample(tex##L, input.tc, wrap_t##L).x;}
  """
  shaderCode:t="""
    float layers[16]; uint indices[16];
    GET_LAYER(0);GET_LAYER(1);GET_LAYER(2);GET_LAYER(3);GET_LAYER(4);GET_LAYER(5);GET_LAYER(6);GET_LAYER(7);
    GET_LAYER(8);GET_LAYER(9);GET_LAYER(10);GET_LAYER(11);GET_LAYER(12);GET_LAYER(13);GET_LAYER(14);GET_LAYER(15);

    uint ret_index0 = index0, ret_index1 = index0;
    float lastHt = -1, prevHt = -2;

    for (uint l = 0; l < 16; ++l)
    {
      float ht = layers[l] > 0 ? layers[l] + layer_delta*l : 0;
      if (ht > lastHt)
      {
        ret_index1 = ret_index0;
        ret_index0 = indices[l];
        prevHt = lastHt;
        lastHt = ht;
      }
    }

    result.col0.xy = float2(ret_index0, ret_index1)/255.;
    result.col0.z = 0;
    result.col0.w = saturate((lastHt-prevHt)*ht_mask_scale + 0.5);
  """
}


min
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="result.col0 = input.tc.z*min(linear_sample(tex0, input.tc, wrap_t0), linear_sample(tex1, input.tc, wrap_t1));"
}

polynomial_smooth_min // from http://www.iquilezles.org/www/articles/smin/smin.htm
{
  inputs:i=2

  params
  {
    smooth:r = 0.1
  }
  shaderPreMain:t="""
   cbuffer global
   {
     float smooth;
   };
   Texture2D tex0:register(t0);
   Texture2D tex1:register(t1);
   SamplerState sampler0:register(s0);
   SamplerState sampler1:register(s1);
  """

  shaderCode:t="""
  float4 a = linear_sample(tex0, input.tc, wrap_t0);
  float4 b = linear_sample(tex1, input.tc, wrap_t1);
  float x = max(smooth, 1e-3);
  float4 k = float4(x, x, x, x);
  float4 h = saturate(0.5 + 0.5 * (b - a) / k);

  result.col0 = input.tc.z * (lerp(b, a, h) - k * h * (1.0 - h));
  """
}

get_normal
{
  inputs:i = 1
  params
  {
    cell_size:r = 128.0
  }
  shaderPreMain:t="""
   cbuffer global
   {
     float cell_size;
   };
   Texture2D tex0:register(t0);
   SamplerState sampler0:register(s0);
  """

  shaderCode:t="""
  result.col0 = float4(getNormal(tex0, wrap_t0, input.tc, cell_size), 0) * 0.5 + 0.5;
  """
}

get_curvature
{
  inputs:i = 1
  params
  {
    scale:r = 1.0
  }
  shaderPreMain:t="""
   cbuffer global
   {
     float scale;
   };
   Texture2D tex0:register(t0);
   SamplerState sampler0:register(s0);
  """

  shaderCode:t="""
  result.col0 = -getCurvature(tex0, wrap_t0, input.tc, scale) * 0.5 + 0.5;
  """
}


polynomial_smooth_max
{
  inputs:i=2

  params
  {
    smooth:r = 0.1
  }
  shaderPreMain:t="""
   cbuffer global
   {
     float smooth;
   };
   Texture2D tex0:register(t0);
   Texture2D tex1:register(t1);
   SamplerState sampler0:register(s0);
   SamplerState sampler1:register(s1);
  """

  shaderCode:t="""
  float4 a = -linear_sample(tex0, input.tc, wrap_t0);
  float4 b = -linear_sample(tex1, input.tc, wrap_t1);
  float x = max(smooth, 1e-3);
  float4 k = float4(x, x, x, x);
  float4 h = saturate(0.5 + 0.5 * (b - a) / k);

  result.col0 = -input.tc.z * (lerp(b, a, h) - k * h * (1.0 - h));
  """
}

