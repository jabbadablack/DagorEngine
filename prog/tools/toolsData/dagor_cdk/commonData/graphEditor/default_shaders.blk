  SamplerState sampler3:register(s3);
  """
  shaderCode:t="""
    float r = linear_sample(tex0, input.tc, wrap_t0).x;
    float g = linear_sample(tex1, input.tc, wrap_t1).x;
    float b = linear_sample(tex2, input.tc, wrap_t2).x;
    float a = linear_sample(tex3, input.tc, wrap_t3).x;
    result.col0 = float4(r, g, b, a);
  """
}

