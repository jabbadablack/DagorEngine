  SamplerState sampler2:register(s2);
  """
  shaderCode:t="result.col0 = input.tc.z * lerp(linear_sample(tex0, input.tc, wrap_t0), linear_sample(tex1, input.tc, wrap_t1), linear_sample(tex2, input.tc, wrap_t2).r);"
}

