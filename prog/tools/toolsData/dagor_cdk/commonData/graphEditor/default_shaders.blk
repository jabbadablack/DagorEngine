apply_gradient
{
  inputs:i=2
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  Texture2D tex1:register(t1);
  SamplerState sampler0:register(s0);
  SamplerState sampler1:register(s1);
  """
  shaderCode:t="""
    float2 gradDim;
    tex1.GetDimensions(gradDim.x, gradDim.y);
    float v = (saturate(linear_sample(tex0, input.tc, wrap_t0).x) * (gradDim.x - 1.0) + 0.5) / gradDim.x;
    result.col0 = linear_sample(tex1, float2(v, 0.0), false);
  """
}

lerp_tex
{
  inputs:i=3
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
