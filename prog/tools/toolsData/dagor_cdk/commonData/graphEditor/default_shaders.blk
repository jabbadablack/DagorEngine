linear_to_srgb
{
  inputs:i=1
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  SamplerState sampler0:register(s0);
  """
  shaderCode:t="""
    float4 linearCol = linear_sample(tex0, input.tc, wrap_t0);
    float3 sRGBLo = linearCol.rgb * 12.92;
    float3 sRGBHi = ( pow( abs( linearCol.rgb ), 1.0 / 2.4) * 1.055) - 0.055;
    float3 sRGB = ( linearCol.rgb <= 0.0031308) ? sRGBLo : sRGBHi;
    result.col0 = float4(sRGB, linearCol.a);
  """
}

srgb_to_linear
{
  inputs:i=1
  shaderPreMain:t="""
  Texture2D tex0:register(t0);
  SamplerState sampler0:register(s0);
  """
  shaderCode:t="""
    float4 sRGBcol = linear_sample(tex0, input.tc, wrap_t0);
    float3 linearLo = sRGBcol.rgb / 12.92;
    float3 linearHi = pow((abs(sRGBcol.rgb) + 0.055) / 1.055, 2.4);
    float3 linearColor = (sRGBcol.rgb <= 0.04045) ? linearLo : linearHi;
    result.col0 = float4(linearColor, sRGBcol.a);
  """
}


