node {
  templateUid:t = "e473450d-af4f-4968-ae16-be8052bbfa35"
  name:t = "export entities"
  category:t = "Output"
  synonyms:t = "particles,result,save"
  nativeShader:t = "unary"
  allowLoop:b = no
  width:i = 320
  addHeight:i = 20
  dynSizeToRight:b = yes

  pin {
    name:t = "particles"
    caption:t = """
(%blk name%)
%names list%
"""
    types:t = "particles"
    singleConnect:b = yes
    role:t = "in"
    data {
      customParam:t = 'saveEntitiesToFile:t="%blk name%"; entitiesNames:t="%names list%";'
      customBlkParams:t = 'particles {reg:t="$particles$";} blending:t="add";'
    }
  }
  pin {
    name:t = "tmp_reg"
    types:t = "texture2D"
    singleConnect:b = yes
    role:t = "in"
    hidden:b = yes
    data {
      def_val:t = "tex:color:0.5,0.5,0.5,1"
    }
  }
  pin {
    name:t = "res"
    types:t = "texture2D"
    singleConnect:b = no
    role:t = "out"
    hidden:b = yes
    data {
      final:b = yes
    }
  }

  property {
    name:t = "blk name"
    type:t = "filepath"
    root:t = "entityDir"
    mask:t = "Entities (*.blk)|*.blk"
    val:t = "entities.blk"
  }
  property {
    name:t = "names list"
    val:t = "name1,name2"
  }
}

