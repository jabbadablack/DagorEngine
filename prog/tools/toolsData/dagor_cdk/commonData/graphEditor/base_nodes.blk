node {
  templateUid:t = "e9c40e8f-d682-4021-b803-6701341256af"
  name:t = "result"
  category:t = "Output"
  synonyms:t = "final,result,output"
  allowLoop:b = no
  width:i = 120
  dynSizeToRight:b = yes

  pin {
    name:t = "result"
    caption:t = "(%texture name%)"
    types:t = "texture2D"
    singleConnect:b = yes
    role:t = "in"
    data {
      final:b = yes
    }
  }

  property {
    name:t = "texture name"
    val:t = "finalResult"
  }
  property {
    name:t = "skip when exporting"
    val:b = no
  }
}

node {
  templateUid:t = "0a3557dc-8c4f-46a2-9f2b-030af5dbaa86"
  name:t = "export texture"
  category:t = "Output"
  synonyms:t = "final,result,output"
  allowLoop:b = no
  width:i = 420
  dynSizeToRight:b = yes

  pin {
    name:t = "name"
    caption:t = "%texture name%%file format% (%channels%)"
    types:t = "texture2D"
    singleConnect:b = yes
    role:t = "in"
    data {
      final:b = yes
    }
  }

  property {
    name:t = "texture name"
    val:t = "untitled"
  }
  property {
    name:t = "file format"
    type:t = "combobox"
    val:t = ".tif"
    items {
      item:t = ".tif"
      item:t = ".tga"
      item:t = ".raw"
    }
  }
  property {
    name:t = "channels"
    type:t = "combobox"
    val:t = "ARGB8"
    items {
      item:t = "bitmap"
      item:t = "R8"
      item:t = "R16"
      item:t = "R16F"
      item:t = "R32"
      item:t = "R32F"
      item:t = "RGB8"
      item:t = "RGB16"
      item:t = "RGB16F"
      item:t = "RGB32"
      item:t = "RGB32F"
      item:t = "ARGB8"
      item:t = "ARGB16"
      item:t = "ARGB16F"
      item:t = "ARGB32"
      item:t = "ARGB32F"
    }
  }
}

