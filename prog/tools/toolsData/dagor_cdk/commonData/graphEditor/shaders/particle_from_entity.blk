  descName:t = "integer pixel index"
  pin {
    name:t = "pixel index"
    role:t = "out"
    types:t = "int"
    data {
      code:t = "int(_in.tc.x / ddx_fine(_in.tc.x) + 0.125) + int(_in.tc.y / ddy_fine(_in.tc.y) + 0.125) * int(1.0 / ddx_fine(_in.tc.x) + 0.125)"
    }
  }
}
node {
  id:i = 5
  x:r = 728.9081527347781
  y:r = 315.5789473684209
  descName:t = "out particle"
  pin {
    name:t = "append"
    role:t = "in"
    types:t = "float"
    data {
      def_val:t = "1.0"
      def_val_blk:t = "1.0"
      code:t = """
{
    ParticleInstance tmp_particle
"""
    }
  }
  pin {
    name:t = "pos"
    role:t = "in"
    types:t = "float2"
    data {
      def_val:t = "float2(0.5, 0.5)"
      def_val_blk:t = "0.5, 0.5"
      code:t = "  tmp_particle.pos = $pos$"
    }
  }
  pin {
    name:t = "scale"
    role:t = "in"
    types:t = "float2"
    customPinInput:t = "_scale_20861"
    data {
      def_val:t = "float2(1.0, 1.0)"
      def_val_blk:t = "1.0, 1.0"
      code:t = "  tmp_particle.scale = $scale$"
    }
  }
  pin {
    name:t = "angle"
    role:t = "in"
    types:t = "float"
    customPinInput:t = "_angle_11396"
    data {
      def_val:t = "0.0"
      def_val_blk:t = "0.0"
      code:t = "  tmp_particle.angle = $angle$"
    }
  }
  pin {
    name:t = "brightness"
    role:t = "in"
    types:t = "float"
    customPinInput:t = "_brightness_50764"
    data {
      def_val:t = "1.0"
      def_val_blk:t = "1.0"
      code:t = "  tmp_particle.brightness = $brightness$"
    }
  }
  pin {
    name:t = "depth"
    role:t = "in"
    types:t = "float"
    customPinInput:t = "_depth_31976"
    data {
      def_val:t = "0.5"
      def_val_blk:t = "0.5"
      code:t = """
  tmp_particle.depth = $depth$;
    [branch]
    if ($append$ > 0.0) { uint instIdx; InterlockedAdd(instancesCounter[1], 1, instIdx);instances[instIdx] = tmp_particle; wrap_particle(tmp_particle); }
  }
"""
    }
  }
  pin {
    name:t = "out"
    role:t = "out"
    types:t = "particles"
  }
}
