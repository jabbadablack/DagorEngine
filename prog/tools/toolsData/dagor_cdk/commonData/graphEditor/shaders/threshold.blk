node {
  id:i = 2
  x:r = 685.063783783784
  y:r = 319.9308108108109
  descName:t = "if A>=B"
  groupTypes {
    group2:t = "float"
  }
  pin {
    name:t = "A"
    role:t = "in"
    types:t = "float"
    group:t = "group1"
  }
  pin {
    name:t = "B"
    role:t = "in"
    types:t = "float"
    group:t = "group1"
  }
  pin {
    name:t = "A>=B"
    role:t = "in"
    types:t = "float"
    group:t = "group2"
  }
  pin {
    name:t = "A<B"
    role:t = "in"
    types:t = "float"
    group:t = "group2"
  }
  pin {
    name:t = "res"
    role:t = "out"
    types:t = "float"
    group:t = "group2"
    data {
      code:t = "(($A$ >= $B$) ? ($A>=B$) : ($A<B$))"
    }
  }
}
