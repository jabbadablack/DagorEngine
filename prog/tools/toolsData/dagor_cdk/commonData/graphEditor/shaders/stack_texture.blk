node {
  id:i = 6
  x:r = 1060.0
  y:r = 620.0
  descName:t = "if A>B"
  groupTypes {
    group2:t = "float4"
  }
  pin {
    name:t = "A"
    role:t = "in"
    types:t = "float"
    group:t = "group1"
  }
  pin {
    name:t = "B"
    role:t = "in"
    types:t = "float"
    group:t = "group1"
  }
  pin {
    name:t = "A>B"
    role:t = "in"
    types:t = "float4"
    group:t = "group2"
  }
  pin {
    name:t = "A<=B"
    role:t = "in"
    types:t = "float4"
    group:t = "group2"
  }
  pin {
    name:t = "res"
    role:t = "out"
    types:t = "float4"
    group:t = "group2"
    data {
      code:t = "(($A$ > $B$) ? ($A>B$) : ($A<=B$))"
    }
  }
}
