    role:t = "in"
    types:t = "float"
    group:t = "group1"
  }
  pin {
    name:t = "min_v"
    role:t = "in"
    types:t = "float"
    data {
      def_1:b = no
    }
  }
  pin {
    name:t = "max_v"
    role:t = "in"
    types:t = "float"
    data {
      def_1:b = yes
    }
  }
  pin {
    name:t = "res"
    role:t = "out"
    types:t = "float"
    group:t = "group1"
    data {
      code:t = "saturate(($x$ - $min_v$) / ($max_v$ - $min_v$))"
    }
  }
}
