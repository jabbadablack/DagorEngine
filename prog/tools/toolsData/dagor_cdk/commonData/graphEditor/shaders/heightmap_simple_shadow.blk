description {
  name:t = "[[description-name]]"
  category:t = "[[description-category]]"
  plugin:t = "shader_editor"
  generated:b = yes
  allowLoop:b = no
  width:i = 200
  pin {
    name:t = "height"
    types:t = "texture2D"
    role:t = "in"
    singleConnect:b = yes
    yPos:i = 627
  }
  pin {
    name:t = "direction"
    types:t = "float"
    role:t = "in"
    singleConnect:b = yes
    yPos:i = 874
    data {
      blk_code:t = "%direction%"
      code:t = "%direction%"
    }
  }
  pin {
    name:t = "out"
    types:t = "texture2D"
    role:t = "out"
    singleConnect:b = no
    yPos:i = 1056
    subgraphElem:i = 14
    subgraphPin:i = 1
  }
  pin {
    name:t = "distance"
    types:t = "float"
    role:t = "in"
    singleConnect:b = yes
    yPos:i = 1291
    data {
      blk_code:t = "%distance%"
      code:t = "%distance%"
    }
  }
  pin {
    name:t = "A+B"
    types:t = "float4"
    role:t = "out"
    singleConnect:b = no
    yPos:i = 1324
    subgraphElem:i = 88
    subgraphPin:i = 2
    data {
      code:t = "($A$ + $B$)"
    }
  }
  property {
    name:t = "direction"
    minVal:r = -1000000000.0
    maxVal:r = 1000000000.0
    step:r = 0.001
    val:r = 90.0
  }
  property {
    name:t = "distance"
    minVal:r = -1000000000.0
    maxVal:r = 1000000000.0
    step:r = 0.001
    val:r = 0.05
  }
}
