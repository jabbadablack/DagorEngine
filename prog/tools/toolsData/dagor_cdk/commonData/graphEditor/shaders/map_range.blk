  pin {
    name:t = "x"
    role:t = "in"
    types:t = "float"
    group:t = "group1"
  }
  pin {
    name:t = "min_v"
    role:t = "in"
    types:t = "float"
    data {
      def_1:b = no
    }
  }
  pin {
    name:t = "max_v"
