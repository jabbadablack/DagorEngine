node {
  id:i = 0
  x:r = 4220.0
  y:r = 1380.0
  descName:t = "out particle"
  pin {
    name:t = "append"
    role:t = "in"
    types:t = "float"
    data {
      def_val:t = "1.0"
      def_val_blk:t = "1.0"
      code:t = """
{
    ParticleInstance tmp_particle; tmp_particle.reserved0 = 0; tmp_particle.reserved1 = 0;
"""
    }
  }
  pin {
    name:t = "pos"
    role:t = "in"
    types:t = "float2"
    data {
      def_val:t = "float2(0.5, 0.5)"
      def_val_blk:t = "0.5, 0.5"
      code:t = "  tmp_particle.pos = $pos$"
    }
  }
  pin {
    name:t = "scale"
    role:t = "in"
    types:t = "float2"
    data {
      def_val:t = "float2(1.0, 1.0)"
      def_val_blk:t = "1.0, 1.0"
      code:t = "  tmp_particle.scale = $scale$"
    }
  }
  pin {
    name:t = "angle"
    role:t = "in"
    types:t = "float"
    data {
      def_val:t = "0.0"
      def_val_blk:t = "0.0"
      code:t = "  tmp_particle.angle = $angle$"
    }
  }
  pin {
    name:t = "brightness"
    role:t = "in"
    types:t = "float"
    data {
      def_val:t = "1.0"
      def_val_blk:t = "1.0"
      code:t = "  tmp_particle.brightness = $brightness$"
    }
  }
  pin {
    name:t = "depth"
    role:t = "in"
    types:t = "float"
    data {
      def_val:t = "0.5"
      def_val_blk:t = "0.5"
      code:t = """
  tmp_particle.depth = $depth$;

"""
    }
  }
  pin {
    name:t = "out"
    role:t = "out"
    types:t = "particles"
  }
  pin {
    name:t = "entity world pos"
    role:t = "in"
    types:t = "float3"
    data {
      def_val:t = "float3(0.0, 0.0, 0.0)"
      def_val_blk:t = "0.0, 0.0, 0.0"
      code:t = "  tmp_particle.entityWorldPos = $entity world pos$"
    }
  }
  pin {
    name:t = "entity forward"
    role:t = "in"
    types:t = "float3"
    data {
      def_val:t = "float3(1.0, 0.0, 0.0)"
      def_val_blk:t = "1.0, 0.0, 0.0"
      code:t = "  tmp_particle.entityForward = $entity forward$"
    }
  }
  pin {
    name:t = "entity up"
    role:t = "in"
    types:t = "float3"
    data {
      def_val:t = "float3(0.0, 1.0, 0.0)"
      def_val_blk:t = "0.0, 1.0, 0.0"
      code:t = "  tmp_particle.entityUp = $entity up$"
    }
  }
  pin {
    name:t = "entity name index"
    role:t = "in"
    types:t = "int"
    data {
      def_val:t = "0"
      def_val_blk:t = "0"
      code:t = "  tmp_particle.entityNameIndex = $entity name index$"
    }
  }
  pin {
    name:t = "entity place type"
    role:t = "in"
    types:t = "int"
    data {
      def_val:t = "0"
      def_val_blk:t = "0"
      code:t = "  tmp_particle.entityPlaceType = $entity place type$"
    }
  }
  pin {
    name:t = "entity seed"
    role:t = "in"
    types:t = "int"
    data {
      def_val:t = "0"
      def_val_blk:t = "0"
      code:t = "  tmp_particle.entitySeed = $entity seed$"
    }
  }
  pin {
    name:t = "entity scale"
    role:t = "in"
    types:t = "float3"
    data {
      def_val:t = "float3(1.0, 1.0, 1.0)"
      def_val_blk:t = "1.0, 1.0, 1.0"
      code:t = """
  tmp_particle.entityScale = $entity scale$;
    [branch]
    if ($append$ > 0.0) { uint instIdx; InterlockedAdd(instancesCounter[1], 1, instIdx);instances[instIdx] = tmp_particle; wrap_particle(tmp_particle); }
  }
"""
    }
  }
}
