  type:t="e3dcolor"
  caption:t="Emission color"
}

specularStr {
  type:t="triple_real"
  caption:t="specularStr:"
  constrains_int:ip2=1,10
  use_real_min:b=true
}

bump_multiplier{
  type:t="triple_real"
  caption:t="Bump multiplier value:"
  constrains_real:p2=0,0
  use_real_min:b=true
}
bump_texcoord_multiplier{
  type:t="triple_real"
  caption:t="Bump TC multiplier value:"
  constrains_real:p2=0,0
  use_real_min:b=true
}
