gloss_tex
{
  type:t="texture"
  caption:t="Gloss and shinneness tex:"
  slot:i=4
}

water_normal_tex_0
{
  type:t="texture"
  caption:t="Water texture #1:"
  texture:t="de_water_shape.dds"
  slot:i=0
}

water_normal_tex_1
{
  type:t="texture"
  caption:t="Water texture #2:"
  texture:t="de_water_shape.dds"
  slot:i=1
}

