atest
{
  type:t="triple_int"
  caption:t="Alpha test:"
  constrains_int:ip2=1,255
}

lighting
{
  type:t="combo"
  caption:t="Lighting:"
  values
  {
    val:t="none"
    val:t="lightmap"
    val:t="vltmap"
  }
  def:t="vltmap"
}

specularScale
{
  type:t="triple_real"
  caption:t="Specular scale:"
  constrains_real:p2=0.001,0
  use_real_min:b=true
  use_real_max:b=false
}

shininess
{
  type:t="triple_real"
  caption:t="Shininess:"
  constrains_real:p2=0,0
  use_real_min:b=true
}

min_fresnel
{
  type:t="triple_real"
  caption:t="Min fresnel value:"
  constrains_real:p2=0,0
  use_real_min:b=true
}

max_fresnel
{
  type:t="triple_real"
  caption:t="Max fresnel value:"
  constrains_real:p2=1,1
  use_real_min:b=true
}

fresnel_power
{
  type:t="triple_real"
  caption:t="Fresnel power:"
  constrains_real:p2=0,0
  use_real_min:b=true
}

two_sided
{
  //do not change custom parameters names because there are hardcoded in tool code
  type:t="custom"
}

mat_diff
{
  type:t="e3dcolor"
  caption:t="Diffuse color"
}

