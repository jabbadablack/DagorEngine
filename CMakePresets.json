{
  "version": 10,
  "$comment": "The engine's presets: <platform>[-<compiler>][-<instrumentation>]-<variant>. Build and test presets build Dev; pass --config Rel|IRel|Dbg (ctest: -C) for another configuration. ci-* presets are what CI runs. Local presets go into CMakeUserPresets.json (ignored by git).",
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
