  "testPresets": [
    {
      "name": "windows-tests",
      "configurePreset": "windows-tests",
      "configuration": "Dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-windows-tests",
      "configurePreset": "windows-tests",
      "configuration": "Dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "label": "requires-gpu|requires-display"
