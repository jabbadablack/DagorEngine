// Windows resources of the game executable: icon and version info (VERSION_NUM comes from the jamfile)
#define GAME_NAME "Dng Empty"
#define GAME_ICON "dng_empty.ico"
#define GAME_DESCRIPTION "Dng Empty"

#define ID_ICON       101

#define _INC_CRTDEFS

#define APSTUDIO_READONLY_SYMBOLS
#include <windows.h>
#undef APSTUDIO_READONLY_SYMBOLS

#ifdef _WIN32
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
#endif //_WIN32

ID_ICON              ICON     GAME_ICON
AppIcon              ICON     GAME_ICON

#ifndef VERSION_NUM
#define VERSION_NUM 0,0,0,0
#endif

#define MACRO_VA_STR(...) #__VA_ARGS__
#define VERSION_STRINGIFY(...) MACRO_VA_STR(__VA_ARGS__)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_NUM
 PRODUCTVERSION VERSION_NUM
 FILEFLAGSMASK 0x17L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", GAME_DESCRIPTION
            VALUE "FileVersion", VERSION_STRINGIFY(VERSION_NUM)
            VALUE "InternalName", GAME_NAME
            VALUE "ProductName", GAME_NAME
            VALUE "ProductVersion", VERSION_STRINGIFY(VERSION_NUM)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
