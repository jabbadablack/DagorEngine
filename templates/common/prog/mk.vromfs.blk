folder { path:t="@ENGINE_FROM_PROG@/prog/1stPartyLibs/daScript/daslib"; dest_path:t="daslib"; scan_folder:b=yes; scan_subfolders:b=yes; wildcard:t="*.das"; wildcard:t="*.das_project"; wildcard:t="*.blk"; wildcard:t="*.nut"; wildcard:t="*.svg"; wildcard:t="*.json"; }
folder { path:t="@ENGINE_FROM_PROG@/prog/daNetGame/scripts/globals"; dest_path:t="daNetGame/qscripts"; scan_folder:b=yes; scan_subfolders:b=yes; wildcard:t="*.das"; wildcard:t="*.das_project"; wildcard:t="*.blk"; wildcard:t="*.nut"; wildcard:t="*.svg"; wildcard:t="*.json"; }
folder { path:t="@ENGINE_FROM_PROG@/prog/daNetGame/scripts/das"; dest_path:t="das"; scan_folder:b=yes; scan_subfolders:b=yes; wildcard:t="*.das"; wildcard:t="*.das_project"; wildcard:t="*.blk"; wildcard:t="*.nut"; wildcard:t="*.svg"; wildcard:t="*.json"; }
