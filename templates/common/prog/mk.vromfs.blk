folder { path:t="@ENGINE_FROM_PROG@/prog/scripts/sq/std"; dest_path:t="sq/std"; scan_folder:b=yes; scan_subfolders:b=yes; wildcard:t="*.das"; wildcard:t="*.das_project"; wildcard:t="*.blk"; wildcard:t="*.nut"; wildcard:t="*.svg"; wildcard:t="*.json"; }
