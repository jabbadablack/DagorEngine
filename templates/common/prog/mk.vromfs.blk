platform:t="PC"
outputRoot_PC:t="../game/"
output:t="@GAME_ID@.vromfs.bin"
allowMkDir:b=yes
pack:b=yes
rootFolder:t="."
folder { path:t="gameBase"; dest_path:t="."; scan_folder:b=yes; scan_subfolders:b=yes; wildcard:t="*.das"; wildcard:t="*.das_project"; wildcard:t="*.blk"; wildcard:t="*.nut"; wildcard:t="*.svg"; wildcard:t="*.json"; }
folder { path:t="scripts"; dest_path:t="scripts"; scan_folder:b=yes; scan_subfolders:b=yes; wildcard:t="*.das"; wildcard:t="*.das_project"; wildcard:t="*.blk"; wildcard:t="*.nut"; wildcard:t="*.svg"; wildcard:t="*.json"; }
