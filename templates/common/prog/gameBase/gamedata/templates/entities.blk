import:t="%danetlibs/renderer/templates/dng_camera_nodes.template.blk"
import:t="%danetlibs/renderer/templates/aa_benchmark.template.blk"
import:t="%danetlibs/renderer/templates/render_settings.template.blk"
import:t="%danetlibs/renderer/templates/dynamic_lighting.template.blk"
import:t="%danetlibs/renderer/templates/ui_nodes.template.blk"
import:t="%danetlibs/frame_graph_renderer/templates/frame_graph_nodes.template.blk"

replicating { replication { _tags:t="net"; } }
depth_of_field {
  _singleton:b=yes
  _tags:t="render"
  "dof:DepthOfFieldPS" {}
  "downsampled_dof_frame_fallback:UniqueTex" {}
}

// Load the project's exported daEditor level.
starter_level {
  level {}
  level__blk:t="gamedata/levels/starter.blk"
  level__weather:t=""
  level__timeRange:p2=12,12
  level__timeSeed:i=1
  level__timeOfDay:r=12
  level__weatherSeed:i=1
  level__cloudsHoleEnabled:b=no
  "level__weatherChoice:object" {}
  level__render:b=no
}
starter_camera {
  "camera_view:tag" { _tags:t="gameClient"; }
  camera__active:b=yes
  fov:r=75
  znear:r=0.05
  zfar:r=10000
  transform:m=[[1,0,0] [0,1,0] [0,0,1] [0,3,-10]]
}
// Engine camera component contract; no sample templates are imported.
free_cam {
  _use:t="starter_camera"
  camera__active:b=no
  camera__input_enabled:b=yes
  editableObj:b=no
  free_cam { _tags:t="gameClient"; }
  input { _tags:t="input"; }
  free_cam__mouse:p2=0,0
  starter__cameraInputOwned:b=no
  free_cam__move:p2=0,0
  free_cam__rotate:p2=0,0
  free_cam__shiftY:r=0
  free_cam__turbo:b=no
  free_cam__bank:r=0
  free_cam__angSpdScale:p2=0.001,0.001
  free_cam__move_speed:r=5
  free_cam__moveSpeedDefault:r=5
  base_transform:m=[[1,0,0] [0,1,0] [0,0,1] [0,0,0]]
  _tracked:t="camera__active"
  _tracked:t="free_cam__move_speed"
  _tracked:t="free_cam__angSpdScale"
  "free_cam_input__move:u16" { value:i=-1; }
  "free_cam_input__rotate:u16" { value:i=-1; }
  "free_cam_input__shiftY:u16" { value:i=-1; }
  "free_cam_input__zoomIn:u16" { value:i=-1; }
  "free_cam_input__zoomOut:u16" { value:i=-1; }
  "free_cam_input__turbo:u16" { value:i=-1; }
  "free_cam_input__speedUp:u16" { value:i=-1; }
  "free_cam_input__speedDown:u16" { value:i=-1; }
  "free_cam_input__speedReset:u16" { value:i=-1; }
  "free_cam_input__bank:u16" { value:i=-1; }
}
daeditor_selected { "daeditor__selected:tag"{} }

include "network.blk"

msg_sink { _singleton:b=yes; msg_sink{} replication { _tags:t="net"; } }

// Required by the host's input lifecycle, independently of game input systems.
glob_input {
  input { _tags:t="input"; }
  "glob_input:tag" { _tags:t="input"; }
  "glob_input__inputMode:i" { _tags:t="input"; value:i=0; }
}
